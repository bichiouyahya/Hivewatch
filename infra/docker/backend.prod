FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY backend/ .

COPY infra/docker/backend-entrypoint.prod.sh /usr/local/bin/hive-entrypoint
RUN chmod +x /usr/local/bin/hive-entrypoint

# 8000 API, 2222 SSH honeypot, 8080 HTTP honeypot
EXPOSE 8000 2222 8080

ENTRYPOINT ["/usr/local/bin/hive-entrypoint"]
