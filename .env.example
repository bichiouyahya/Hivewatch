# Every value here has a working default, so the stack runs without this
# file. Copy it to .env only to change something.

# Database
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=hive
POSTGRES_PORT=55432

# Ports published on the host
API_PORT=8000
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080
DASHBOARD_PORT=3000

# Honeypot
SENSOR_ID=hive-dev
# The only SSH password that opens a shell. Any username works with it.
SSH_PASSWORD=adminpass
RATE_LIMIT_PER_MINUTE=120
GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# Dashboard and API
NEXT_PUBLIC_API_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:3000
# Leave empty to keep the API open. Set it if you publish the API port.
API_TOKEN=

# Production only (compose.prod.yml)
# PUBLIC_URL=http://your-host:8088
# PUBLIC_PORT=8088
